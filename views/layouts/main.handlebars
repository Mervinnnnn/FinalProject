<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} | ChatApp</title>
    <!-- Original CDNs Restored -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { background: #c1bcb0; color: #e0e0e0; min-height: 100vh; }
        .navbar { background: #c1b69e !important; border-bottom: 1px solid #0f3460; }
        .navbar-brand { color: #e94560 !important; font-weight: 700; }
        .nav-link { color: #a0a0b0 !important; }
        .nav-link:hover { color: #e94560 !important; }
        .badge-online { background: #28a745; width: 10px; height: 10px;
            border-radius: 50%; display: inline-block; }
        
        /* Ensures the mobile hamburger button matches your theme colors */
        .navbar-toggler { border-color: rgba(233, 69, 96, 0.5); }
        .navbar-toggler-icon { filter: invert(39%) sepia(87%) saturate(2465%) hue-rotate(326deg) brightness(98%) contrast(92%); }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container px-4">
            <a class="navbar-brand" href="/chat">
                <i class="bi bi-chat-dots-fill me-2"></i>ChatApp
            </a>
            
            <!-- Mobile Toggle Button (Hamburger) -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mobileNavbarMenu" aria-controls="mobileNavbarMenu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Linked Menu Container using ID -->
            <div class="collapse navbar-collapse" id="mobileNavbarMenu">
                <!-- Added py-2 py-lg-0 for clean vertical spacing on mobile screens -->
                <ul class="navbar-nav ms-auto align-items-center gap-2 py-2 py-lg-0">
                    {{#if isLoggedIn}}
                    <li class="nav-item">
                        <span class="nav-link">
                            <span class="badge-online me-1"></span>
                            {{ currentUser.username }}
                            {{#if isAdmin}}<span class="badge bg-danger ms-1">Admin</span>{{/if}}
                        </span>
                    </li>
                    <li class="nav-item w-100 text-center text-lg-start">
                        <form action="/auth/logout" method="POST">
                            <!-- w-100 stretches the logout button cleanly on small viewports -->
                            <button class="btn btn-sm btn-outline-danger w-100">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </button>
                        </form>
                    </li>
                    {{else}}
                    <li class="nav-item">
                        <a class="nav-link" href="/auth/login">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/auth/register">Register</a>
                    </li>
                    {{/if}}
                </ul>
            </div>
        </div>
    </nav>
    <div class="container-fluid px-0">
        {{{body}}}
    </div>
    <!-- Original JS CDN Restored -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
